# Local development against `supabase start`. Copy to .env.
SUPABASE_URL=http://127.0.0.1:54321
# Printed by `supabase status` as PUBLISHABLE_KEY. Never put the secret key here.
SUPABASE_PUBLISHABLE_KEY=
ALLOWED_GOOGLE_DOMAIN=example.org

# "local" is refused unless SUPABASE_URL points at localhost. Production uses "google".
KMS_MODE=local
# openssl rand -base64 32
LOCAL_KMS_KEY=
# Password shared by the throwaway dev accounts of the local sign-in form. 12 characters minimum.
DEV_LOGIN_PASSWORD=

# Production only: projects/<project>/locations/<region>/keyRings/<ring>/cryptoKeys/<key>
KMS_KEY_NAME=
